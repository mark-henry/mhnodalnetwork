DROP TABLE IF EXISTS edges;
DROP TABLE IF EXISTS nodes;
DROP TABLE IF EXISTS graphs;

CREATE TABLE graphs (
    id integer PRIMARY KEY,
    name varchar(40)
);

CREATE TABLE nodes (
    id integer PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,
    graph_id integer REFERENCES graphs (id) ON DELETE CASCADE,
    name varchar(60),
    descr varchar(300)
);

CREATE TABLE edges (
    n1 integer REFERENCES nodes (id) ON DELETE CASCADE,
    n2 integer REFERENCES nodes (id) ON DELETE CASCADE,
    PRIMARY KEY (n1, n2),
    CHECK (n1 < n2)
);
CREATE INDEX n1_idx on edges (n1);
CREATE INDEX n2_idx on edges (n2);